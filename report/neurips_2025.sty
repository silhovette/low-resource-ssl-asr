% neurips_2025.sty — NeurIPS-style formatting for course project
% ProvidesNeurIPS-like typography without depending on external .sty

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{neurips_2025}[2025/06/30 NeurIPS 2025 style]

% -------- options --------
\newif\if@neurips@final \@neurips@finalfalse
\DeclareOption{final}{\@neurips@finaltrue}
\newif\if@neurips@preprint \@neurips@preprintfalse
\DeclareOption{preprint}{\@neurips@preprinttrue}
\ProcessOptions\relax

% -------- geometry: centered text block 5.5in wide on 8.5in paper --------
\setlength{\paperwidth}{8.5in}
\setlength{\paperheight}{11in}
\setlength{\textwidth}{5.5in}
\setlength{\textheight}{9in}
% Center the text block: (8.5 - 5.5) / 2 = 1.5, so oddsidemargin = 0.5in
\setlength{\oddsidemargin}{0.5in}
\setlength{\evensidemargin}{0.5in}
\setlength{\topmargin}{-0.25in}
\setlength{\headheight}{0pt}
\setlength{\headsep}{0pt}
\setlength{\marginparwidth}{0.6in}
\setlength{\footskip}{0.6in}

% -------- fonts: Times + Helvetica + Latin Modern Typewriter --------
\renewcommand{\rmdefault}{ptm}
\renewcommand{\sfdefault}{phv}
% Use Courier for typewriter — much better match with Times than CM typewriter
\renewcommand{\ttdefault}{pcr}

% -------- typography --------
\frenchspacing                       % single space after periods
\setlength{\parindent}{0pt}
\setlength{\parskip}{0.33\baselineskip plus 0.1\baselineskip minus 0.05\baselineskip}
\raggedbottom                        % allow uneven bottom — avoids stretched pages
\tolerance=1200                      % tighter than \sloppy (9999) but looser than default (200)
\emergencystretch=0.5em              % small extra stretch to prevent overfull boxes
\widowpenalty=10000
\clubpenalty=10000
\exhyphenpenalty=200                 % encourage hyphenation over loose lines

% -------- microtype recommended --------
\RequirePackage{microtype}
% microtype will be loaded by main.tex; don't force it here

% -------- section headings --------
% Tight spacing, bold, numbered, no raggedright
\renewcommand\section{\@startsection{section}{1}{\z@}%
  {-2.5ex \@plus -0.5ex \@minus -0.2ex}%
  {1.3ex \@plus 0.2ex}%
  {\normalfont\large\bfseries}}
\renewcommand\subsection{\@startsection{subsection}{2}{\z@}%
  {-2.0ex \@plus -0.5ex \@minus -0.2ex}%
  {0.8ex \@plus 0.2ex}%
  {\normalfont\normalsize\bfseries}}
\renewcommand\subsubsection{\@startsection{subsubsection}{3}{\z@}%
  {-1.5ex \@plus -0.25ex \@minus -0.1ex}%
  {0.5ex \@plus 0.1ex}%
  {\normalfont\normalsize\bfseries\itshape}}
\renewcommand\paragraph{\@startsection{paragraph}{4}{\z@}%
  {1ex \@plus 1ex \@minus 0.2ex}%
  {-1em}%
  {\normalfont\normalsize\bfseries}}

% -------- float tuning --------
\setcounter{topnumber}{3}
\renewcommand{\topfraction}{0.90}
\renewcommand{\bottomfraction}{0.70}
\renewcommand{\textfraction}{0.10}
\renewcommand{\floatpagefraction}{0.75}
\setcounter{bottomnumber}{2}
\setcounter{totalnumber}{4}

% -------- captions --------
\setlength{\abovecaptionskip}{6pt}
\setlength{\belowcaptionskip}{4pt}
% caption style: small, slightly tighter
\long\def\@makecaption#1#2{%
  \vskip\abovecaptionskip
  \sbox\@tempboxa{\small\textbf{#1.} #2}%
  \ifdim \wd\@tempboxa >\hsize
    {\small\textbf{#1.} #2\par}%
  \else
    \global \@minipagefalse
    \hb@xt@\hsize{\hfil\box\@tempboxa\hfil}%
  \fi
  \vskip\belowcaptionskip}

% -------- title block --------
\renewcommand{\maketitle}{%
  \thispagestyle{empty}%
  \begin{center}%
    \vspace*{-0.1in}%
    {\LARGE\bfseries\@title\par}%
    \vskip 0.3in%
    {\large\@author\par}%
    \vskip 0.2in%
  \end{center}%
  \vskip 0.15in%
}

% -------- abstract --------
\renewenvironment{abstract}{%
  \begin{center}%
    {\normalsize\bfseries Abstract}%
  \end{center}%
  \vspace{-0.3em}%
  \begin{quote}%
  \small
}{%
  \end{quote}%
  \vspace{0.15in}%
}

% -------- lists --------
\setlength{\leftmargini}{1.5em}
\setlength{\leftmarginii}{1.25em}
\setlength{\leftmarginiii}{1.25em}
\setlength{\itemsep}{1pt}
\setlength{\topsep}{2pt}
\setlength{\parsep}{1pt}

% -------- reference section --------
% bibsep is defined by natbib — natbib is loaded below in providers

% -------- acknowledgments --------
\newenvironment{ack}{%
  \section*{Acknowledgments}%
  \small
}{}

% -------- providers --------
\RequirePackage{color}
\RequirePackage{natbib}
\setlength{\bibsep}{2pt plus 0.5pt minus 0.5pt}  % compact bibliography

% -------- bib style --------
\newcommand{\neuripsbibstyle}{\bibliographystyle{abbrvnat}}

\endinput
